{
  "extends": [
    "eslint:recommended",
    "plugin:node/recommended"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es6": false,
    "jquery": true
  },
  "globals": {
    "jasmine": false,
    "describe": false,
    "it": false,
    "before": false,
    "after": false
  },
  "rules": {
    "no-var": "off"
  }
}
